# Replace this site's existing location / proxy; do not append a duplicate.
# Keep the site's existing TLS certificate / ACME configuration in BaoTa.
location ~ (^|/)\. { return 404; }
location / {
    proxy_pass http://127.0.0.1:56043;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 3600s;
    # Mode 1 is a development build: no CDN/static cache until production rollout.
    proxy_hide_header Cache-Control;
    proxy_hide_header Expires;
    add_header Cache-Control "no-store" always;
}
