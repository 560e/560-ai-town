# 复制为 .env.local，或运行 npm run local:setup 自动生成随机的本地配置。
DATABASE_URL=postgresql://town_app:YOUR_PASSWORD@127.0.0.1:55460/town_local
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BETTER_AUTH_URL=http://localhost:3000
# 仅开发模式＋本机访问启用。生产构建绝不会展示测试码或接受测试注册。
TOWN_LOCAL_AUTH=1
# 本地密码功能。公开部署请使用 deploy-linux.sh 的密码模式，强制 HTTPS 并关闭本地 OTP。
TOWN_PASSWORD_AUTH=1
# 只在仅可信反向代理能访问上游时开启，向导会配置；不要直接暴露应用端口。
TOWN_TRUST_PROXY=0
# 私有管理路径段：gate- 后接32位随机十六进制字符，两者必须不同。
# 使用 npm run local:setup 自动生成；已有 .env.local 可运行 node scripts/management-entry.mjs 补充。
# TOWN_MANAGE_ENTRY=gate-<random-32-hex>
# TOWN_SYSTEM_ENTRY=gate-<another-random-32-hex>
